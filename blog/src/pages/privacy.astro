---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Privacy Policy";
const description =
  "Read the official Privacy Policy for Authentic Nerd. We respect your data and privacy while exploring systems thinking and software engineering.";
const lastUpdated = "March 2, 2026";
---

<BaseLayout pageTitle={pageTitle} description={description} ogType="website">
  <div class="leading-relaxed text-inherit">
    <section class="my-8">
      <h1 class="text-navy mb-2 text-4xl leading-tight font-bold italic dark:text-white">
        The "Authentic Nerd" Privacy Policy
      </h1>
      <p class="mb-4 text-sm opacity-70">Last Updated: {lastUpdated}</p>
      <p class="border-terracotta bg-navy/5 border-l-4 py-2 pl-4 text-lg italic dark:bg-white/5">
        "I value your privacy as much as I value my own system's uptime."
      </p>
    </section>

    <section class="my-8">
      <h2 class="text-navy mb-4 text-2xl font-bold dark:text-white">Data Collection</h2>
      <p class="mb-4">This website respects your privacy by collecting as little data as possible.</p>
      <ul class="mb-4 ml-2 list-inside list-disc space-y-2">
        <li>
          <strong>No Tracking:</strong> There are no analytics scripts, marketing pixels, or cross-site trackers.
        </li>
        <li>
          <strong>No Cookies:</strong> This site does not set any advertising or tracking cookies on your device.
        </li>
      </ul>
    </section>

    <section class="my-8">
      <h2 class="text-navy mb-4 text-2xl font-bold dark:text-white">Security Logs</h2>
      <p class="mb-4">
        To keep the site secure and functional, the hosting provider automatically generates basic server access logs.
      </p>
      <ul class="mb-4 ml-2 list-inside list-disc space-y-2">
        <li>
          <strong>What is logged:</strong> Basic request details, such as your IP address and the pages you visit.
        </li>
        <li>
          <strong>Purpose:</strong> This data is used strictly to defend against malicious bots, prevent abuse, and fix system
          errors.
        </li>
        <li>
          <strong>Retention:</strong> All access logs are automatically and permanently deleted after 90 days.
        </li>
      </ul>
    </section>

    <section class="border-navy/10 my-8 border-t pt-8 dark:border-white/10">
      <h2 class="text-navy mb-4 text-xl font-bold dark:text-white">Contact</h2>
      <p>
        If you have questions about this policy, feel free to reach out via
        <a href="https://www.linkedin.com/in/jerometerry" target="_blank" class="text-terracotta hover:underline"
          >LinkedIn
        </a> or check the source on
        <a href="https://github.com/jerometerry/authenticnerd" target="_blank" class="text-terracotta hover:underline"
          >GitHub
        </a>.
      </p>
    </section>
  </div>
</BaseLayout>
