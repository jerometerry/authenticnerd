---
import BaseLayout from "./BaseLayout.astro";
import BlogTag from "@components/BlogTag.astro";
import { Image } from "astro:assets";

const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title} description={frontmatter.description}>
  <div class="mb-8">
    <h1 class="text-navy mb-8 text-center text-4xl font-bold dark:text-white">
      {frontmatter.title}
    </h1>

    <div class="flex flex-col text-gray-600 dark:text-gray-400">
      <p class="mb-2 text-sm font-semibold">
        {frontmatter.pubDate.toISOString().slice(0, 10)}
      </p>
      <p class="mt-1 italic">
        {frontmatter.subtitle}
      </p>
    </div>
  </div>

  <Image
    src={frontmatter.image.url}
    alt={frontmatter.image.alt}
    class="zoomable-image mb-8 h-auto w-full max-w-[300px] rounded-lg shadow-md"
  />

  <div
    class="prose prose-lg prose-p:leading-relaxed prose-code-clean prose-headings:text-navy prose-a:text-[#00539F] [&_a:hover]:text-peach prose-img:rounded-xl dark:prose-invert dark:prose-headings:text-white dark:prose-a:text-blue-300 dark:[&_a:hover]:text-peach mb-10 max-w-none"
  >
    <slot />
  </div>

  <div class="flex flex-wrap gap-2 border-t border-gray-200 pt-4 dark:border-gray-700">
    {frontmatter.tags.map((tag: string) => <BlogTag tag={tag} />)}
  </div>
</BaseLayout>
